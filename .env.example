# ============================================================
# CRICZONE — Environment Variables Template
# Copy to .env.local and fill real values.
# ============================================================

# Supabase (public — safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (SECRET — server only, NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (share links, auth callbacks, OG metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin allow-list (only this email can access /admin)
ADMIN_EMAIL=arfatmomin7709@gmail.com